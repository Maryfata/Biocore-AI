# BIOCORE AI — environment variables
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is not.
# app/main.py loads this `.env` at startup (variables already set in the
# environment take precedence). Nothing is ever hard-coded in source.

# ─────────────────────────────────────────────────────────────
# Clinical AI narrator (domain/physiology/narrator/) — OPTIONAL
# ─────────────────────────────────────────────────────────────
# The only real AI integration in the project. Without this key the app runs
# fine; the narrator panels display an explicit "not configured" notice
# (NarratorNotConfiguredError) instead of falling back to fake text.
ANTHROPIC_API_KEY=sk-your-key-here

# Optional: override the narrator model (default: claude-opus-4-8).
# BIOCORE_CLAUDE_MODEL=claude-opus-4-8
